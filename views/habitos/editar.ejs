<%- include('../partials/header') %>

<div class="form-container">
    <h2>Editar Hábito</h2>
    
    <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
    <% } %>
    
    <form action="/habitos/editar/<%= habito.id %>" method="POST">
        <div class="form-group">
            <label for="nombre">Nombre del hábito *:</label>
            <input type="text" id="nombre" name="nombre" value="<%= habito.nombre %>" required minlength="3">
        </div>
        
        <div class="form-group">
            <label for="descripcion">Descripción (opcional):</label>
            <textarea id="descripcion" name="descripcion" rows="3"><%= habito.descripcion || '' %></textarea>
        </div>
        
        <div class="form-actions">
            <button type="submit" class="btn-primary">Guardar Cambios</button>
            <a href="/habitos" class="btn-secondary">Cancelar</a>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>