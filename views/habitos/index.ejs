<%- include('../partials/header') %>

<h1>Mis Hábitos</h1>

<% if (habitos.length === 0) { %>
    <div class="empty-state">
        <p>🎯 No tienes hábitos aún</p>
        <a href="/habitos/nuevo" class="btn-primary">Crear mi primer hábito</a>
    </div>
<% } else { %>
    <div class="habitos-grid">
        <% habitos.forEach(habito => { %>
            <div class="habito-card">
                <div class="habito-header">
                    <h3><%= habito.nombre %></h3>
                    <div class="habito-actions">
                        <a href="/habitos/editar/<%= habito.id %>" class="btn-icon">✏️</a>
                        <button onclick="eliminarHabito(<%= habito.id %>)" class="btn-icon btn-delete">🗑️</button>
                    </div>
                </div>
                
                <% if (habito.descripcion) { %>
                    <p class="habito-descripcion"><%= habito.descripcion %></p>
                <% } %>
                
                <div class="habito-stats">
                    <div class="stat">
                        <span class="stat-label">Racha actual:</span>
                        <span class="stat-value" id="racha-actual-<%= habito.id %>"><%= habito.racha_actual %></span>
                        <span>días</span>
                    </div>
                    <div class="stat">
                        <span class="stat-label">Mejor racha:</span>
                        <span class="stat-value" id="racha-maxima-<%= habito.id %>"><%= habito.racha_maxima %></span>
                        <span>días</span>
                    </div>
                </div>
                
                <div class="habito-footer">
                    <% if (habito.ultimo_check === new Date().toISOString().split('T')[0]) { %>
                        <button class="btn-completado" disabled>✅ Completado hoy</button>
                    <% } else { %>
                        <button onclick="marcarHabito(<%= habito.id %>, this)" class="btn-marcar">
                            ✓ Marcar como completado
                        </button>
                    <% } %>
                </div>
            </div>
        <% }) %>
    </div>
<% } %>

<%- include('../partials/footer') %>